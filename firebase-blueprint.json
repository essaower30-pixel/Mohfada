{
  "entities": {
    "user": {
      "title": "User",
      "description": "Registered resident, merchant, or admin user in the community wallet system",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user ID"
        },
        "name": {
          "type": "string",
          "description": "User full name"
        },
        "phone": {
          "type": "string",
          "description": "Phone number"
        },
        "accountNumber": {
          "type": "string",
          "description": "Unique account number"
        },
        "pin": {
          "type": "string",
          "description": "4-digit security PIN"
        },
        "role": {
          "type": "string",
          "description": "User role",
          "enum": ["resident", "merchant", "admin"]
        },
        "balance": {
          "type": "number",
          "description": "Current wallet digital balance"
        },
        "avatar": {
          "type": "string",
          "description": "Avatar URL or placeholder"
        },
        "shopName": {
          "type": "string",
          "description": "Optional shop name for merchants"
        },
        "shopCategory": {
          "type": "string",
          "description": "Category of shop"
        },
        "joinedDate": {
          "type": "string",
          "description": "ISO date of registration"
        },
        "isFrozen": {
          "type": "boolean",
          "description": "Whether account is frozen"
        },
        "status": {
          "type": "string",
          "description": "Status of the account",
          "enum": ["active", "suspended"]
        }
      },
      "required": ["id", "name", "phone", "accountNumber", "role", "balance"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "Financial ledger record of cash charges, withdrawals, and user transfers",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique transaction ID"
        },
        "type": {
          "type": "string",
          "description": "Transaction type",
          "enum": ["admin_cash_charge", "admin_cash_withdraw", "p2p_transfer", "merchant_pay"]
        },
        "amount": {
          "type": "number",
          "description": "Amount in local currency"
        },
        "fee": {
          "type": "number",
          "description": "Admin transfer fee returning to vault"
        },
        "senderId": {
          "type": "string",
          "description": "Sender user ID"
        },
        "senderName": {
          "type": "string",
          "description": "Sender name"
        },
        "recipientId": {
          "type": "string",
          "description": "Recipient user ID"
        },
        "recipientName": {
          "type": "string",
          "description": "Recipient name"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp"
        },
        "note": {
          "type": "string",
          "description": "Transaction note or reason"
        },
        "receiptCode": {
          "type": "string",
          "description": "Verification receipt code"
        }
      },
      "required": ["id", "type", "amount", "senderId", "recipientId", "receiptCode"]
    },
    "adminVault": {
      "title": "AdminVault",
      "description": "Central community reserve vault metrics and cash drawer tracking",
      "type": "object",
      "properties": {
        "digitalVaultBalance": {
          "type": "number",
          "description": "Central digital reserve balance"
        },
        "cashInDrawer": {
          "type": "number",
          "description": "Physical cash collected and held in drawer"
        },
        "cashPaidOut": {
          "type": "number",
          "description": "Physical cash disbursed to residents"
        },
        "totalIssuedToUsers": {
          "type": "number",
          "description": "Total active balance held across all community users"
        },
        "transferFeeRate": {
          "type": "number",
          "description": "Commission percentage on transfers"
        },
        "totalAdminFeesCollected": {
          "type": "number",
          "description": "Cumulative fees returned to administration"
        }
      },
      "required": ["digitalVaultBalance", "cashInDrawer", "cashPaidOut", "totalIssuedToUsers"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/user"
      },
      "description": "Stores user profiles, roles, and current balance"
    },
    "/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/entities/transaction"
      },
      "description": "Stores ledger of all cash charges, cash withdrawals, and transfers"
    },
    "/admin_vault/{vaultId}": {
      "schema": {
        "$ref": "#/entities/adminVault"
      },
      "description": "Central administrative vault balance and settings"
    }
  }
}
